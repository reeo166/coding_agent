# Copy this file to .env. Pass it explicitly with --config .env.

DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Legacy CODING_AGENT_API_KEY/BASE_URL/MODEL names remain supported.

# Optional JSON headers for gateways that require account/project metadata.
# CODING_AGENT_EXTRA_HEADERS={"X-Project":"example"}
# CODING_AGENT_TIMEOUT=120
# CODING_AGENT_MAX_STEPS=30
# CODING_AGENT_MAX_CONTEXT_CHARS=120000
